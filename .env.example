# Copy to .env for local development. NEVER commit a real key.
# The evaluator will set AI_API_KEY at runtime.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Cost / token tuning (defaults shown)
AI_MAX_STEPS=20
AI_MAX_OUTPUT_TOKENS=2048
AI_HISTORY_WINDOW=40
AI_MAX_TOOL_CHARS=4000
AI_MAX_TOOL_LINES=200
AI_WORKDIR=.

# Optimisation layer (defaults shown)
AI_EXTERNALIZE_THRESHOLD=8000
AI_TOKEN_BUDGET=200000
AI_LOOP_WINDOW=20
AI_LOOP_IDENTICAL=5
AI_LOOP_FREQ=50
AI_PARALLEL_TOOLS=true

# Sub-agent (task tool) configuration
AI_SUBAGENT_MODEL=
AI_SUBAGENT_MAX_STEPS=15
AI_SUBAGENT_DEFAULT_MAX_TURNS=10
