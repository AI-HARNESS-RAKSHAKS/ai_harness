# Copy to .env for local development. NEVER commit a real key.
# The evaluator will set AI_API_KEY at runtime.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Cost / token tuning (defaults shown — tuned for fast responses)
AI_MAX_STEPS=15
AI_MAX_OUTPUT_TOKENS=1024
AI_HISTORY_WINDOW=30
AI_MAX_TOOL_CHARS=2500
AI_MAX_TOOL_LINES=120
AI_WORKDIR=.

# Optimisation layer (defaults shown)
AI_EXTERNALIZE_THRESHOLD=3000
AI_TOKEN_BUDGET=80000
AI_LOOP_WINDOW=15
AI_LOOP_IDENTICAL=4
AI_LOOP_FREQ=30
AI_PARALLEL_TOOLS=true

# Sub-agent (task tool) configuration
AI_SUBAGENT_MODEL=
AI_SUBAGENT_MAX_STEPS=10
AI_SUBAGENT_DEFAULT_MAX_TURNS=8
